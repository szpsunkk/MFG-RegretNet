{
  "name": "privacy-as-commodity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev site --port 8091",
    "test": "node --test tests/*.test.mjs",
    "test:evidence": "node tests/evidence.mjs",
    "test:api": "node tests/api-flow.mjs",
    "test:capacity": "node tests/full-room.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "db:local": "wrangler d1 execute privacy-commodity-auctions --local --file schema.sql",
    "db:remote": "wrangler d1 execute privacy-commodity-auctions --remote --file schema.sql",
    "deploy": "wrangler pages deploy site --project-name privacy-as-commodity --branch main --commit-dirty=true"
  },
  "devDependencies": {"wrangler": "4.151.3"}
}
